          "reason": "native Windows extension test"
        }
      }
    },
    "f5-sales-demo/xcsh": {
      ".github/workflows/ci.yml": {
        "setup-zig-native": {
          "runs_on": "matrix",
          "reason": "native macOS and Windows toolchain validation"
        },
        "native-nonlinux": {
          "runs_on": "matrix",
          "reason": "native macOS and Windows release validation"
        },
        "build-sign-macos": {
          "runs_on": "matrix",
          "reason": "Apple signing and notarization require macOS"
        },
        "verify-homebrew-install": {
          "runs_on": "macos-14",
          "reason": "Homebrew release verification requires macOS"
        }
      },
      ".github/workflows/container.yml": {
        "container-build-arm64": {
          "runs_on": "ubuntu-24.04-arm",
          "reason": "native ARM64 container validation"
        }
      },
      ".github/workflows/test-codesign.yml": {
        "test-codesign": {
          "runs_on": "matrix",
          "reason": "Apple code signing requires native macOS"
        }
      }
    },
    "f5-sales-demo/xcsh-action": {
      ".github/workflows/ci.yml": {
        "test-native": {
          "runs_on": "matrix",
          "reason": "action behavior must be validated on macOS and Windows"
        },
        "validate-native": {
          "runs_on": "matrix",
          "reason": "manifest validation covers native macOS, Windows, and ARM64"
        }
      }
